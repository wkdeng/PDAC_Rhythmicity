# =============================================================================
# ChronoTherapy RNA-seq Processing Pipeline
# Designed for TACC LS6 cluster (SLURM) with Apptainer containers
#
# Workflow: FastQC -> Kallisto/STAR -> featureCounts -> rMATS/DaPars -> MultiQC
# Adapted from ChronoTherapy/process.smk for cluster execution
# =============================================================================
shell.prefix("set -eo pipefail; ")

import os
import glob

configfile: "config.yaml"

# --- Configuration ---
# Resolve all paths to absolute so they work inside Apptainer containers
# and when SLURM jobs run from different working directories
BATCH = config["batch"]
RAW_DIR = os.path.abspath(config["raw_dir"])
KALLISTO_IDX = os.path.abspath(config["kallisto_idx"])
STAR_IDX = os.path.abspath(config["star_idx"])
GTF_PATH = os.path.abspath(config["gtf"])
UTR3_BED = os.path.abspath(config["utr3_bed"])
GENOME_SIZE_FILE = os.path.abspath(config["genome_size_file"])
APPTAINER_SIF = config["apptainer_sif"]  # already absolute

RMATS_PYTHON = config["rmats_python"]    # container-internal path
RMATS_PATH = config["rmats_path"]        # container-internal path
READ_LENGTH = config["read_length"]
READ_TYPE = config["read_type"]

DAPARS_SCRIPT = config["dapars_script"]  # container-internal path
DAPARS_COVERAGE = config["dapars_coverage"]
DAPARS_FDR = config["dapars_fdr"]
DAPARS_PDUI = config["dapars_pdui"]
DAPARS_FOLD_CHANGE = config["dapars_fold_change"]

SLURM_ACCOUNT = config["slurm"]["account"]
SLURM_PARTITION = config["slurm"]["partition"]

# Project root (parent of pipeline/) — bind this so container sees both
# pipeline/ and data/ directories
PROJECT_DIR = os.path.abspath("..")
DATA_DIR = os.path.abspath(f"../data/{BATCH}")
LOGS_DIR = os.path.abspath("../data/logs")

print(f"PROJECT_DIR: {PROJECT_DIR}")
print(f"DATA_DIR: {DATA_DIR}")
print(f"RAW_DIR: {RAW_DIR}")


def get_sample_info():
    """Extract sample names from paired-end fastq files in raw directory."""
    samples = []
    fastq_files = glob.glob(f"{RAW_DIR}/*_1.fastq")
    for f in fastq_files:
        basename = os.path.basename(f)
        sample_name = basename.replace("_1.fastq", "")
        samples.append(sample_name)
    return sorted(samples)


SAMPLES = get_sample_info()

print(f"Found {len(SAMPLES)} samples")
if len(SAMPLES) > 0:
    print(f"First 5 samples: {SAMPLES[:5]}")


def get_r1(wildcards):
    return f"{RAW_DIR}/{wildcards.sample}_1.fastq"


def get_r2(wildcards):
    return f"{RAW_DIR}/{wildcards.sample}_2.fastq"


# --- Local rules (run on head node, not submitted to SLURM) ---
localrules: all, create_bam_list, create_combined_bam_list, create_dapars_config


# =============================================================================
# Target rule
# =============================================================================

rule all:
    input:
        fastqc_r1=expand(f"{DATA_DIR}/fastqc/{{sample}}_R1_fastqc.html", sample=SAMPLES),
        fastqc_r2=expand(f"{DATA_DIR}/fastqc/{{sample}}_R2_fastqc.html", sample=SAMPLES),
        kallisto=expand(f"{DATA_DIR}/kallisto/{{sample}}/abundance.tsv", sample=SAMPLES),
        star_bam=expand(f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam", sample=SAMPLES),
        star_log=expand(f"{DATA_DIR}/star/{{sample}}/Log.final.out", sample=SAMPLES),
        featurecounts=f"{DATA_DIR}/featurecounts/gene_counts.tsv",
        bedgraph=expand(f"{DATA_DIR}/bedgraph/{{sample}}.bedgraph", sample=SAMPLES),
        rmats_prep=expand(f"{DATA_DIR}/rmats/prep/{{sample}}/prep_completed.txt", sample=SAMPLES),
        rmats_post=f"{DATA_DIR}/rmats/post/post_completed.txt",
        dapars=expand(f"{DATA_DIR}/dapars/results/{{sample}}/dapars_completed.txt", sample=SAMPLES),
        multiqc=f"{DATA_DIR}/multiqc/multiqc_report.html",


# =============================================================================
# Quality Control
# =============================================================================

rule fastqc:
    input:
        r1=get_r1,
        r2=get_r2,
    output:
        r1_html=f"{DATA_DIR}/fastqc/{{sample}}_R1_fastqc.html",
        r1_zip=f"{DATA_DIR}/fastqc/{{sample}}_R1_fastqc.zip",
        r2_html=f"{DATA_DIR}/fastqc/{{sample}}_R2_fastqc.html",
        r2_zip=f"{DATA_DIR}/fastqc/{{sample}}_R2_fastqc.zip",
    log:
        f"{LOGS_DIR}/{BATCH}/fastqc/{{sample}}.log",
    params:
        out_dir=f"{DATA_DIR}/fastqc",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 10
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="02:00:00",
        mem_mb=8192,
    shell:
        """
        echo "=== fastqc: {wildcards.sample} ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        mkdir -p {params.out_dir}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Input R1: {input.r1}"
        echo "Input R2: {input.r2}"
        echo "Output dir: {params.out_dir}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            fastqc -o {params.out_dir} -t {threads} {input.r1} {input.r2} > {log} 2>&1

        # Rename outputs to match expected names
        r1_base=$(basename {input.r1} .fastq)
        r2_base=$(basename {input.r2} .fastq)

        if [ -f {params.out_dir}/${{r1_base}}_fastqc.html ]; then
            ln -sf ${{r1_base}}_fastqc.html {output.r1_html}
            ln -sf ${{r1_base}}_fastqc.zip {output.r1_zip}
        fi
        if [ -f {params.out_dir}/${{r2_base}}_fastqc.html ]; then
            ln -sf ${{r2_base}}_fastqc.html {output.r2_html}
            ln -sf ${{r2_base}}_fastqc.zip {output.r2_zip}
        fi

        echo "=== fastqc: {wildcards.sample} DONE ==="
        """


# =============================================================================
# Quantification
# =============================================================================

rule kallisto_quant:
    input:
        r1=get_r1,
        r2=get_r2,
    output:
        h5=f"{DATA_DIR}/kallisto/{{sample}}/abundance.h5",
        tsv=f"{DATA_DIR}/kallisto/{{sample}}/abundance.tsv",
        json=f"{DATA_DIR}/kallisto/{{sample}}/run_info.json",
    log:
        f"{LOGS_DIR}/{BATCH}/kallisto/{{sample}}.log",
    params:
        index=KALLISTO_IDX,
        out_dir=f"{DATA_DIR}/kallisto/{{sample}}",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 40
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="04:00:00",
        mem_mb=32768,
    shell:
        """
        echo "=== kallisto_quant: {wildcards.sample} ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p {params.out_dir}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Input R1: {input.r1}"
        echo "Input R2: {input.r2}"
        echo "Kallisto index: {params.index}"
        echo "Output dir: {params.out_dir}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            kallisto quant -i {params.index} -o {params.out_dir} -t {threads} \
                {input.r1} {input.r2} > {log} 2>&1

        echo "=== kallisto_quant: {wildcards.sample} DONE ==="
        """


rule star_align:
    input:
        r1=get_r1,
        r2=get_r2,
    output:
        bam=f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam",
        sj=f"{DATA_DIR}/star/{{sample}}/SJ.out.tab",
        log_final=f"{DATA_DIR}/star/{{sample}}/Log.final.out",
        log_progress=f"{DATA_DIR}/star/{{sample}}/Log.progress.out",
        log_out=f"{DATA_DIR}/star/{{sample}}/Log.out",
        unmapped_1=f"{DATA_DIR}/star/{{sample}}/Unmapped.out.mate1",
        unmapped_2=f"{DATA_DIR}/star/{{sample}}/Unmapped.out.mate2",
    log:
        f"{LOGS_DIR}/{BATCH}/star/{{sample}}.log",
    params:
        index=STAR_IDX,
        gtf=GTF_PATH,
        prefix=f"{DATA_DIR}/star/{{sample}}/",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 48
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="08:00:00",
        mem_mb=65536,
    shell:
        """
        echo "=== star_align: {wildcards.sample} ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p {params.prefix}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Input R1: {input.r1}"
        echo "Input R2: {input.r2}"
        echo "STAR index: {params.index}"
        echo "GTF: {params.gtf}"
        echo "Output prefix: {params.prefix}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            STAR --genomeDir {params.index} \
                --readFilesIn {input.r1} {input.r2} \
                --sjdbGTFfile {params.gtf} \
                --outFileNamePrefix {params.prefix} \
                --outSAMtype BAM SortedByCoordinate \
                --outSAMunmapped Within \
                --outSAMattributes Standard \
                --twopassMode Basic \
                --runThreadN {threads} \
                --outFilterType BySJout \
                --outFilterMultimapNmax 20 \
                --alignSJoverhangMin 8 \
                --alignSJDBoverhangMin 1 \
                --outFilterMismatchNmax 999 \
                --outFilterMismatchNoverReadLmax 0.04 \
                --alignIntronMin 20 \
                --alignIntronMax 1000000 \
                --alignMatesGapMax 1000000 \
                --outReadsUnmapped Fastx \
                > {log} 2>&1

        echo "=== star_align: {wildcards.sample} DONE ==="
        """


rule star_index_bam:
    input:
        f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam",
    output:
        f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam.bai",
    log:
        f"{LOGS_DIR}/{BATCH}/star/{{sample}}_index.log",
    params:
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 4
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="01:00:00",
        mem_mb=8192,
    shell:
        """
        echo "=== star_index_bam: {wildcards.sample} ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Input BAM: {input}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            samtools index -@ {threads} {input} > {log} 2>&1

        echo "=== star_index_bam: {wildcards.sample} DONE ==="
        """


rule featurecounts:
    input:
        bam=expand(f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam", sample=SAMPLES),
        bai=expand(f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam.bai", sample=SAMPLES),
    output:
        counts=f"{DATA_DIR}/featurecounts/gene_counts.tsv",
        summary=f"{DATA_DIR}/featurecounts/gene_counts.tsv.summary",
    log:
        f"{LOGS_DIR}/{BATCH}/featurecounts/gene_counts.log",
    params:
        gtf=GTF_PATH,
        out_dir=f"{DATA_DIR}/featurecounts",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 8
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="02:00:00",
        mem_mb=16384,
    shell:
        """
        echo "=== featurecounts ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p {params.out_dir}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "GTF: {params.gtf}"
        echo "Output: {output.counts}"
        echo "Number of BAMs: $(echo {input.bam} | wc -w)"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            featureCounts \
                -a {params.gtf} \
                -o {output.counts} \
                -T {threads} \
                {input.bam} \
                > {log} 2>&1

        echo "=== featurecounts DONE ==="
        """


# =============================================================================
# Coverage & Aggregation
# =============================================================================

rule convert_bedgraph:
    input:
        bam=f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam",
    output:
        bedgraph=f"{DATA_DIR}/bedgraph/{{sample}}.bedgraph",
    log:
        f"{LOGS_DIR}/{BATCH}/bedgraph/{{sample}}.log",
    params:
        genome_size=GENOME_SIZE_FILE,
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 4
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="02:00:00",
        mem_mb=16384,
    shell:
        """
        echo "=== convert_bedgraph: {wildcards.sample} ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p $(dirname {output.bedgraph})
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Input BAM: {input.bam}"
        echo "Output bedgraph: {output.bedgraph}"
        echo "Genome size file: {params.genome_size}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            genomeCoverageBed -bg -ibam {input.bam} -g {params.genome_size} -split \
                > {output.bedgraph} 2> {log}

        echo "=== convert_bedgraph: {wildcards.sample} DONE ==="
        """


rule multiqc:
    input:
        fastqc=expand(f"{DATA_DIR}/fastqc/{{sample}}_R1_fastqc.zip", sample=SAMPLES),
        kallisto=expand(f"{DATA_DIR}/kallisto/{{sample}}/abundance.tsv", sample=SAMPLES),
        star_log=expand(f"{DATA_DIR}/star/{{sample}}/Log.final.out", sample=SAMPLES),
        featurecounts_summary=f"{DATA_DIR}/featurecounts/gene_counts.tsv.summary",
    output:
        f"{DATA_DIR}/multiqc/multiqc_report.html",
    log:
        f"{LOGS_DIR}/{BATCH}/multiqc.log",
    params:
        out_dir=f"{DATA_DIR}/multiqc",
        search_dir=DATA_DIR,
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 1
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="00:30:00",
        mem_mb=4096,
    shell:
        """
        echo "=== multiqc ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p {params.out_dir}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Search dir: {params.search_dir}"
        echo "Output dir: {params.out_dir}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            multiqc {params.search_dir} -o {params.out_dir} -f > {log} 2>&1

        echo "=== multiqc DONE ==="
        """


# =============================================================================
# rMATS - Alternative Splicing Analysis
# =============================================================================

rule create_bam_list:
    input:
        bam=f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam",
    output:
        bam_list=f"{DATA_DIR}/rmats/bam_lists/per_sample/{{sample}}.txt",
    shell:
        """
        mkdir -p $(dirname {output.bam_list})
        echo "{input.bam}" > {output.bam_list}
        """


rule rmats_prep:
    input:
        bam_list=f"{DATA_DIR}/rmats/bam_lists/per_sample/{{sample}}.txt",
        bam=f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam",
    output:
        completed=f"{DATA_DIR}/rmats/prep/{{sample}}/prep_completed.txt",
    log:
        f"{LOGS_DIR}/{BATCH}/rmats/{{sample}}.log",
    params:
        gtf=GTF_PATH,
        rmats=RMATS_PATH,
        rmats_python=RMATS_PYTHON,
        read_length=READ_LENGTH,
        read_type=READ_TYPE,
        outdir=f"{DATA_DIR}/rmats/prep/{{sample}}",
        tmpdir=f"{DATA_DIR}/rmats/tmp/{{sample}}",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 4
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="04:00:00",
        mem_mb=16384,
    shell:
        """
        echo "=== rmats_prep: {wildcards.sample} ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p {params.outdir}
        mkdir -p {params.tmpdir}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "BAM list: {input.bam_list}"
        echo "BAM list content: $(cat {input.bam_list})"
        echo "GTF: {params.gtf}"
        echo "Output dir: {params.outdir}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            {params.rmats_python} {params.rmats} \
                --b1 {input.bam_list} \
                --gtf {params.gtf} \
                -t {params.read_type} \
                --readLength {params.read_length} \
                --nthread {threads} \
                --od {params.outdir} \
                --tmp {params.tmpdir} \
                --task prep \
                --variable-read-length \
                --individual-counts \
                2>&1 | tee {log}

        echo "=== rmats_prep: {wildcards.sample} DONE ==="
        echo "Completed at $(date)" > {output.completed}
        """


rule create_combined_bam_list:
    input:
        bams=expand(f"{DATA_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam", sample=SAMPLES),
    output:
        combined_list=f"{DATA_DIR}/rmats/bam_lists/all_samples.txt",
    shell:
        """
        mkdir -p $(dirname {output.combined_list})
        echo "{input.bams}" | tr ' ' ',' > {output.combined_list}
        """


rule rmats_post:
    input:
        combined_list=f"{DATA_DIR}/rmats/bam_lists/all_samples.txt",
        prep_completed=expand(f"{DATA_DIR}/rmats/prep/{{sample}}/prep_completed.txt", sample=SAMPLES),
    output:
        completed=f"{DATA_DIR}/rmats/post/post_completed.txt",
    log:
        f"{LOGS_DIR}/{BATCH}/rmats/post.log",
    params:
        gtf=GTF_PATH,
        rmats=RMATS_PATH,
        rmats_python=RMATS_PYTHON,
        read_length=READ_LENGTH,
        read_type=READ_TYPE,
        outdir=f"{DATA_DIR}/rmats/post",
        tmpdir=f"{DATA_DIR}/rmats/tmp",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 48
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="12:00:00",
        mem_mb=65536,
    shell:
        """
        echo "=== rmats_post ==="
        echo "Loading modules"
        source /opt/apps/lmod/lmod/init/bash
        echo "Loading tacc-apptainer module"
        module load tacc-apptainer
        set -eo pipefail

        echo "Creating output directories"
        mkdir -p {params.outdir}
        mkdir -p {params.tmpdir}
        mkdir -p $(dirname {log})

        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Combined BAM list: {input.combined_list}"
        echo "GTF: {params.gtf}"
        echo "Output dir: {params.outdir}"
        echo "Threads: {threads}"
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            {params.rmats_python} {params.rmats} \
                --b1 {input.combined_list} \
                --gtf {params.gtf} \
                -t {params.read_type} \
                --readLength {params.read_length} \
                --nthread {threads} \
                --od {params.outdir} \
                --tmp {params.tmpdir} \
                --task post \
                --statoff \
                --variable-read-length \
                --individual-counts \
                2>&1 | tee {log}

        echo "=== rmats_post DONE ==="
        echo "Completed at $(date)" > {output.completed}
        """


# =============================================================================
# DaPars - Alternative Polyadenylation Analysis
# =============================================================================

rule create_dapars_config:
    input:
        bedgraph=f"{DATA_DIR}/bedgraph/{{sample}}.bedgraph",
        utr3=UTR3_BED,
    output:
        config=f"{DATA_DIR}/dapars/config/{{sample}}_config.txt",
    params:
        outdir=f"{DATA_DIR}/dapars/results/{{sample}}",
        coverage=DAPARS_COVERAGE,
        fdr=DAPARS_FDR,
        pdui=DAPARS_PDUI,
        fold_change=DAPARS_FOLD_CHANGE,
    shell:
        """
        mkdir -p $(dirname {output.config})

        cat > {output.config} <<EOF
Annotated_3UTR={input.utr3}
Group1_Tophat_aligned_Wig={input.bedgraph}
Group2_Tophat_aligned_Wig={input.bedgraph}
Output_directory={params.outdir}
Output_result_file={wildcards.sample}_result
Num_least_in_group1=1
Num_least_in_group2=1
Coverage_cutoff={params.coverage}
FDR_cutoff={params.fdr}
PDUI_cutoff={params.pdui}
Fold_change_cutoff={params.fold_change}
EOF
        """


rule run_dapars:
    input:
        config=f"{DATA_DIR}/dapars/config/{{sample}}_config.txt",
        bedgraph=f"{DATA_DIR}/bedgraph/{{sample}}.bedgraph",
    output:
        completed=f"{DATA_DIR}/dapars/results/{{sample}}/dapars_completed.txt",
    log:
        f"{LOGS_DIR}/{BATCH}/dapars/{{sample}}.log",
    params:
        dapars_script=DAPARS_SCRIPT,
        outdir=f"{DATA_DIR}/dapars/results/{{sample}}",
        sif=APPTAINER_SIF,
        project_dir=PROJECT_DIR,
    threads: 4
    resources:
        account=SLURM_ACCOUNT,
        partition=SLURM_PARTITION,
        walltime="04:00:00",
        mem_mb=16384,
    shell:
        """
        source /opt/apps/lmod/lmod/init/bash
        module load tacc-apptainer
        set -eo pipefail

        mkdir -p {params.outdir}
        mkdir -p $(dirname {log})

        echo "=== run_dapars: {wildcards.sample} ==="
        echo "Host: $(hostname)"
        echo "Working dir: $(pwd)"
        echo "Config file: {input.config}"
        echo "Config content:"
        cat {input.config}
        echo "Apptainer SIF: {params.sif}"
        echo "Bind: {params.project_dir}"

        apptainer exec --cleanenv \
            --bind {params.project_dir}:{params.project_dir} \
            {params.sif} \
            python {params.dapars_script} {input.config} 2>&1 | tee {log}

        echo "=== run_dapars: {wildcards.sample} DONE ==="
        echo "Completed at $(date)" > {output.completed}
        """
